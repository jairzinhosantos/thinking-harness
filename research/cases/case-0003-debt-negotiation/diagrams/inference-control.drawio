<mxfile host="app.diagrams.net">
  <diagram id="inference-control" name="inference-control">
    <mxGraphModel dx="1160" dy="500" grid="1" gridSize="10" page="1" pageWidth="1160" pageHeight="500">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Control de inferencia" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#20364D;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1090" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Test 3 · Política manual fija · Sin mejorador ni actualizador" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#53677B;fontSize=17;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="65" width="1090" height="32" as="geometry" />
        </mxCell>
        <mxCell id="config" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;1. Ajustar inferencia&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;• Temperatura y muestreo&lt;br&gt;• Perfil con razonamiento&lt;br&gt;&lt;b&gt;H manual permanece fija&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF3F9;strokeColor=#C0CCD6;fontColor=#20364D;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="30" y="130" width="330" height="175" as="geometry" />
        </mxCell>
        <mxCell id="evaluate" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;2. Evaluar perfiles&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;• 12 conversaciones conocidas&lt;br&gt;• Comparar con la respuesta esperada&lt;br&gt;&lt;b&gt;Seleccionar si cumple&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF5F1;strokeColor=#C0CCD6;fontColor=#20364D;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="410" y="130" width="330" height="175" as="geometry" />
        </mxCell>
        <mxCell id="confirm" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;3. Confirmar perfil&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;• 8 conversaciones nuevas&lt;br&gt;• 3 respuestas por conversación&lt;br&gt;&lt;b&gt;24 respuestas; perfil sin cambios&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF5F1;strokeColor=#C0CCD6;fontColor=#20364D;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="790" y="130" width="330" height="175" as="geometry" />
        </mxCell>
        <mxCell id="a" value="" source="config" target="evaluate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;strokeColor=#597B98;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b" value="Si cumple" source="evaluate" target="confirm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;strokeColor=#597B98;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Q = aciertos sin infracciones / respuestas.&lt;/b&gt; Meta: al menos 80 %.&lt;br&gt;&lt;b&gt;V = respuestas con infracciones / respuestas.&lt;/b&gt; Se exige cero.&lt;br&gt;Correcta: acción, deuda, pagos y cuota esperados. Infracción: p. ej., cuota impagable o aceptación inventada." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#20364D;fontSize=17;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="335" width="1090" height="95" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Los 8 casos no seleccionan el perfil. Son reservados en este test; después se reutilizaron en otros diagnósticos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#53677B;fontSize=16;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="438" width="1090" height="45" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>