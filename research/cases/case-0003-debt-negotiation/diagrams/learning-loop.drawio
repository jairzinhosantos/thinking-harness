        <mxCell id="retained" value="Siguiente intento con H conservada" source="select" target="propose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;strokeColor=#597B98;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1">
