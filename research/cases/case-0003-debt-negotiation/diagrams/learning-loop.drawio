        </mxCell>
        <mxCell id="update" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;B2 · Actualizador · LLM&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Recibe φ, candidata y fallos de desarrollo.&lt;br&gt;&lt;b&gt;Reemplaza φ para el siguiente intento.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF3E9;strokeColor=#C0CCD6;fontColor=#20364D;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="310" y="585" width="525" height="120" as="geometry" />
        </mxCell>
        <mxCell id="eval-update" value="Fallos" source="eval" target="update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;strokeColor=#A27B49;dashed=1;exitX=0.7;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="update-propose" value="φ nueva" source="update" target="propose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;strokeColor=#A27B49;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
