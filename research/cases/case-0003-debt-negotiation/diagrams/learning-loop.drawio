<mxfile host="app.diagrams.net">
  <diagram id="learning-loop" name="learning-loop">
    <mxGraphModel dx="1160" dy="780" grid="1" gridSize="10" page="1" pageWidth="1160" pageHeight="780">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Automejora del prompt" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#20364D;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1090" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Qwen3 8B · Pesos fijos · Cada rol es una llamada al modelo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#53677B;fontSize=17;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="65" width="1090" height="32" as="geometry" />
        </mxCell>
        <mxCell id="h" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;H0 · Política inicial&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;«Pregunta siempre por la capacidad.&lt;br&gt;No ofrezcas ningún plan».&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF3F9;strokeColor=#C0CCD6;fontColor=#20364D;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="530" height="125" as="geometry" />
        </mxCell>
        <mxCell id="phi" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;φ0 · Instrucciones iniciales&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;«Revisa la política y sus fallos.&lt;br&gt;Propón una mejora».&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF3E9;strokeColor=#C0CCD6;fontColor=#20364D;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="590" y="120" width="530" height="125" as="geometry" />
        </mxCell>
        <mxCell id="propose" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;1. Mejorador · LLM&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;• H conservada + φ + fallos&lt;br&gt;• Devuelve H1, H2…&lt;br&gt;&lt;b&gt;Candidata, aún sin aceptar&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF3F9;strokeColor=#C0CCD6;fontColor=#20364D;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="30" y="310" width="245" height="175" as="geometry" />
        </mxCell>
        <mxCell id="run" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;2. Negociador · LLM&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;• Contrato fijo + H candidata&lt;br&gt;• Recibe deudas y conversación&lt;br&gt;&lt;b&gt;Devuelve action, debt, cuotas&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF3F9;strokeColor=#C0CCD6;fontColor=#20364D;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="310" y="310" width="245" height="175" as="geometry" />
        </mxCell>
        <mxCell id="eval" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;3. Evaluador · Python&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;• Compara decisión esperada&lt;br&gt;• Comprueba restricciones&lt;br&gt;&lt;b&gt;Q: proporción correcta · V: infracciones&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF5F1;strokeColor=#C0CCD6;fontColor=#20364D;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="590" y="310" width="245" height="175" as="geometry" />
        </mxCell>
        <mxCell id="select" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;4. Selección · Python&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;• Q sube ≥ 1 punto % y V = 0&lt;br&gt;• Si no, conserva H anterior&lt;br&gt;&lt;b&gt;Se decide en validación&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF5F1;strokeColor=#C0CCD6;fontColor=#20364D;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="870" y="310" width="250" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p-r" value="" source="propose" target="run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;strokeColor=#597B98;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-e" value="" source="run" target="eval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;strokeColor=#597B98;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s" value="" source="eval" target="select" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;strokeColor=#597B98;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
