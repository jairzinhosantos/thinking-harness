        <mxCell id="feedback" value="Fallos de desarrollo" source="eval" target="propose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;strokeColor=#597B98;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
