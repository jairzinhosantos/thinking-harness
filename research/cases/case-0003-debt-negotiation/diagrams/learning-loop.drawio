        </mxCell>
        <mxCell id="end" value="&lt;b style=&quot;font-size:22px&quot;&gt;Prueba final&lt;/b&gt;&lt;br&gt;&lt;br&gt;Comparar H0 y la política elegida en ocho escenarios." vertex="1" parent="1" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF5F8;strokeColor=#8FAEB8;strokeWidth=1.6;fontColor=#193044;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;spacing=10;">
