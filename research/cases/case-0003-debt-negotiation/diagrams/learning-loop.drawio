          <mxGeometry as="geometry" x="25" y="12" width="700" height="50" />
        </mxCell>
        <mxCell id="sub" value="Test 4 · Qwen3 8B · 2.048 tokens de salida por llamada · Cinco intentos" vertex="1" parent="1" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#193044;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="26" y="64" width="1120" height="40" />
        </mxCell>
        <mxCell id="initial" value="&lt;b&gt;Inicio · H0 y φ0&lt;/b&gt;&lt;br&gt;Probar la política inicial. Registrar fallos y aciertos de referencia." vertex="1" parent="1" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF5F8;strokeColor=#8FAEB8;strokeWidth=1.6;fontColor=#193044;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="25" y="121" width="282" height="102" />
        </mxCell>
        <mxCell id="state" value="&lt;b style=&quot;font-size:22px&quot;&gt;Política vigente&lt;/b&gt;&lt;br&gt;&lt;br&gt;H y sus fallos de desarrollo.&lt;br&gt;Al inicio, H0 pide la capacidad de pago aunque ya se conozca." vertex="1" parent="1" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF5F8;strokeColor=#8FAEB8;strokeWidth=1.6;fontColor=#193044;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="25" y="285" width="282" height="142" />
        </mxCell>
        <mxCell id="prop" value="&lt;b style=&quot;font-size:22px&quot;&gt;1 · Mejorador&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sigue φ (instrucciones de mejora). Revisa H y sus fallos.&lt;br&gt;&lt;b&gt;Propone otra política.&lt;/b&gt;" vertex="1" parent="1" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#E7F3EC;strokeColor=#8FAEB8;strokeWidth=1.6;fontColor=#193044;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="414" y="285" width="295" height="142" />
        </mxCell>
        <mxCell id="neg" value="&lt;b style=&quot;font-size:22px&quot;&gt;2 · Negociador&lt;/b&gt;&lt;br&gt;&lt;br&gt;Aplica la candidata a cada conversación. Devuelve acción, deuda, pagos y cuota." vertex="1" parent="1" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF5F8;strokeColor=#8FAEB8;strokeWidth=1.6;fontColor=#193044;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="814" y="285" width="295" height="142" />
        </mxCell>
        <mxCell id="eval" value="&lt;b style=&quot;font-size:22px&quot;&gt;3 · Evaluador&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Q&lt;/b&gt; = aciertos sin infracciones / respuestas.&lt;br&gt;&lt;b&gt;V&lt;/b&gt; = respuestas con infracción / respuestas." vertex="1" parent="1" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF5F8;strokeColor=#8FAEB8;strokeWidth=1.6;fontColor=#193044;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="814" y="485" width="295" height="172" />
        </mxCell>
        <mxCell id="select" value="&lt;b style=&quot;font-size:22px&quot;&gt;4 · Selección&lt;/b&gt;&lt;br&gt;&lt;br&gt;En validación, aceptar si Q sube al menos 1 punto porcentual y V = 0. En los demás casos, conservar H." vertex="1" parent="1" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#E7F3EC;strokeColor=#8FAEB8;strokeWidth=1.6;fontColor=#193044;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;spacing=10;">
