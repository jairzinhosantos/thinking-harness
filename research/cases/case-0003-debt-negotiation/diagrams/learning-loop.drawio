              <mxPoint x="150" y="645" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fixed" value="&lt;b&gt;B1:&lt;/b&gt; mismo método de mejora.&lt;br&gt;&lt;br&gt;&lt;b&gt;B2:&lt;/b&gt; puede reescribir ese método (φ)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#20364D;fontSize=17;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="875" y="595" width="245" height="100" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Primero se evalúa H0. Tras la búsqueda, H0 y H elegida pasan al test final. B1/B2 son estrategias, no versiones de H." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#53677B;fontSize=16;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="730" width="1090" height="35" as="geometry" />
