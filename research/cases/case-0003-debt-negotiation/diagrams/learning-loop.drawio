<mxfile host="app.diagrams.net"><diagram name="Mejora del harness" id="learning-loop"><mxGraphModel page="1" pageWidth="1080" pageHeight="560" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Cómo se propone y comprueba una mejora" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#40546B;fontFamily=Helvetica;fontSize=25;" vertex="1" parent="1"><mxGeometry x="25" y="15" width="1000" height="38" as="geometry" /></mxCell><mxCell id="subtitle" value="H: política del negociador    ·    φ: instrucciones que guían al mejorador" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#40546B;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="60" width="1000" height="30" as="geometry" /></mxCell><mxCell id="propose" value="1. Proponer&#10;El mejorador usa φ&#10;y los fallos de desarrollo" style="rounded=1;whiteSpace=wrap;html=0;arcSize=10;fillColor=#EEF3F8;strokeColor=#A0B1C2;fontColor=#20344A;fontFamily=Helvetica;fontSize=18;spacing=14;" vertex="1" parent="1"><mxGeometry x="25" y="130" width="225" height="115" as="geometry" /></mxCell><mxCell id="candidate" value="2. Ejecutar&#10;El negociador usa&#10;la política candidata H" style="rounded=1;whiteSpace=wrap;html=0;arcSize=10;fillColor=#EEF3F8;strokeColor=#A0B1C2;fontColor=#20344A;fontFamily=Helvetica;fontSize=18;spacing=14;" vertex="1" parent="1"><mxGeometry x="290" y="130" width="225" height="115" as="geometry" /></mxCell><mxCell id="evaluate" value="3. Medir&#10;Reglas fijas comprueban&#10;la decisión y sus límites" style="rounded=1;whiteSpace=wrap;html=0;arcSize=10;fillColor=#ECF4F0;strokeColor=#9AB6A7;fontColor=#20344A;fontFamily=Helvetica;fontSize=18;spacing=14;" vertex="1" parent="1"><mxGeometry x="555" y="130" width="225" height="115" as="geometry" /></mxCell><mxCell id="select" value="4. Conservar&#10;Solo si mejora validación&#10;sin incumplimientos" style="rounded=1;whiteSpace=wrap;html=0;arcSize=10;fillColor=#ECF4F0;strokeColor=#9AB6A7;fontColor=#20344A;fontFamily=Helvetica;fontSize=18;spacing=14;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="225" height="115" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#657C92;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#40546B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="propose" target="candidate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#657C92;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#40546B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="candidate" target="evaluate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#657C92;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#40546B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="evaluate" target="select"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="update" value="Solo B2: actualizar φ&#10;Usa los fallos de desarrollo&#10;para cambiar cómo proponer" style="rounded=1;whiteSpace=wrap;html=0;arcSize=10;fillColor=#F5F0E9;strokeColor=#B9A385;fontColor=#20344A;fontFamily=Helvetica;fontSize=18;spacing=14;" vertex="1" parent="1"><mxGeometry x="290" y="340" width="300" height="100" as="geometry" /></mxCell><mxCell id="feedback" value="Fallos de desarrollo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#657C92;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#40546B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="evaluate" target="propose"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="loop" value="Siguiente intento con la política conservada" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#657C92;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#40546B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="select" target="propose"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="data" value="Desarrollo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#657C92;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#40546B;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#9B805D;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="evaluate" target="update"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="adapt" value="φ actualizada" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#657C92;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#40546B;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#9B805D;exitX=0;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="update" target="propose"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fixed" value="B1: φ permanece fija.&#10;B2: φ puede cambiar entre intentos." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#40546B;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="670" y="355" width="360" height="65" as="geometry" /></mxCell><mxCell id="footer" value="Modelo y evaluador fijos. Validación selecciona; la prueba final se consulta después.&#10;Este bucle corresponde a los Tests 4 y 5. El Test 3 ajusta inferencia con una política manual fija." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#40546B;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="25" y="480" width="1020" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>